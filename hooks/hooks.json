{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sessionstart-notice.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/posttooluse-dispatch.sh\"",
            "timeout": 60,
            "statusMessage": "Running ASTRA post-edit checks..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inject-feature-dev-cwd.sh\"",
            "timeout": 5,
            "statusMessage": "Injecting sprint worktree context..."
          }
        ]
      }
    ]
  }
}
