{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🌟 ASTRA 방법론이 활성화되어 있습니다. /astra-guide 로 빠른 참조를 확인하세요.'"
          },
          {
            "type": "command",
            "command": "if [ -n \"$SLACK_BOT_TOKEN\" ]; then echo '[ASTRA] Slack 연동이 활성화되어 있습니다. (fect-slack MCP 서버)'; else echo '[ASTRA] SLACK_BOT_TOKEN이 설정되지 않았습니다. Slack 연동을 사용하려면 환경변수를 설정하세요.'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/notify-design-doc-edit.sh\"",
            "timeout": 5,
            "statusMessage": "설계 문서 수정 감지 중..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-forbidden-words.sh\"",
            "timeout": 30,
            "statusMessage": "금칙어 검사 중..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/validate-naming.sh\"",
            "timeout": 30,
            "statusMessage": "네이밍 규칙 검사 중..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/track-sprint-progress.sh\"",
            "timeout": 15,
            "statusMessage": "스프린트 진행 추적 중..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inject-feature-dev-cwd.sh\"",
            "timeout": 5,
            "statusMessage": "sprint worktree 컨텍스트 주입 중..."
          }
        ]
      }
    ]
  }
}
