{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🌟 ASTRA methodology is active. Run /astra-guide for a quick reference.'"
          },
          {
            "type": "command",
            "command": "if [ -n \"$GOOGLE_API_KEY\" ]; then echo '[ASTRA] fect-image (Gemini) MCP enabled.'; else echo '[ASTRA] GOOGLE_API_KEY is not set. Set this environment variable to use the fect-image (Gemini) MCP.'; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$OPENAI_API_KEY\" ]; then echo '[ASTRA] fect-gpt-image (OpenAI) MCP enabled.'; else echo '[ASTRA] OPENAI_API_KEY is not set. Set this environment variable to use the fect-gpt-image MCP.'; fi"
          },
          {
            "type": "command",
            "command": "if [ -z \"$SLACK_BOT_TOKEN\" ]; then echo '[ASTRA] (Optional) SLACK_BOT_TOKEN is not set. To use /slack-import and /extract-backlog, register the fect-slack MCP separately in your environment and set the token.'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/notify-design-doc-edit.sh\"",
            "timeout": 5,
            "statusMessage": "Detecting design document edits..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-forbidden-words.sh\"",
            "timeout": 30,
            "statusMessage": "Checking forbidden words..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/validate-naming.sh\"",
            "timeout": 30,
            "statusMessage": "Checking naming conventions..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/track-sprint-progress.sh\"",
            "timeout": 15,
            "statusMessage": "Tracking sprint progress..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/notify-design-md.sh\"",
            "timeout": 5,
            "statusMessage": "Checking design system SSoT advisory..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inject-feature-dev-cwd.sh\"",
            "timeout": 5,
            "statusMessage": "Injecting sprint worktree context..."
          }
        ]
      }
    ]
  }
}
