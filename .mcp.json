{
  "mcpServers": {
    "fect-image": {
      "command": "npx",
      "args": ["-y", "-p", "@astra-group/fect-mcp-server", "fect-image"],
      "env": {
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}"
      }
    },
    "fect-gpt-image": {
      "command": "npx",
      "args": ["-y", "-p", "@astra-group/fect-mcp-server", "fect-gpt-image"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
